DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
PORT=7860
JWT_SECRET="generate-a-random-secret-key"
ADMIN_PIN="your-admin-pin-here"
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# Brevo (Sendinblue) HTTPS API (Port 443 - Bypasses Railway SMTP restrictions)
# Free tier: 300 emails/day, no custom domain required, verify single Gmail sender
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_FROM_EMAIL="your-gmail@gmail.com"
ADMIN_NOTIFICATION_EMAIL="your-gmail@gmail.com"

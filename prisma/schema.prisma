generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  email          String?         @unique
  pinHash        String
  createdAt      DateTime        @default(now())
  attempts       Attempt[]
  retakeRequests RetakeRequest[]
}

model Quiz {
  id             Int             @id @default(autoincrement())
  title          String
  timeLimit      Int
  questions      Question[]
  attempts       Attempt[]
  retakeRequests RetakeRequest[]
}

model Question {
  id             Int      @id @default(autoincrement())
  quizId         Int
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text           String
  options        Json
  correctAnswer  Int
  answers        Answer[]
}

model Attempt {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      Int
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Float
  status      String
  tabSwitches Int      @default(0)
  createdAt   DateTime @default(now())
  answers     Answer[]
}

model Answer {
  id             Int      @id @default(autoincrement())
  attemptId      Int
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     Int
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Int
}

model RetakeRequest {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     Int
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  category   String    @default("technical")
  reason     String    @db.VarChar(1000)
  status     String    @default("pending")
  adminNote  String?   @db.Text
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([userId, quizId, status])
}
